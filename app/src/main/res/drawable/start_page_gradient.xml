<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:centerColor="#080B12"
                android:endColor="#05060A"
                android:startColor="#0A1020"
                android:type="linear" />
        </shape>
    </item>
    <item android:gravity="top|end">
        <shape android:shape="oval">
            <size
                android:width="420dp"
                android:height="420dp" />
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#00000000"
                android:gradientRadius="210dp"
                android:startColor="#332A4A7A"
                android:type="radial" />
        </shape>
    </item>
    <item android:gravity="bottom|start">
        <shape android:shape="oval">
            <size
                android:width="360dp"
                android:height="360dp" />
            <gradient
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#00000000"
                android:gradientRadius="180dp"
                android:startColor="#221A3050"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
